    m_Metadata:
      m_Items: []
  - m_Id: 12328860061024256
    m_Localized: "Clear the rooms and beat the boss\nDeath restarts the run \xB7
      upgrades are lost\nA also dodges \u2014 brief invulnerability while dashing\nPick
      one of three in reward rooms\nIn reward rooms, A changes which weapon gets
      upgraded and which gets discarded"
    m_Metadata:
      m_Items: []
